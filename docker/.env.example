###############################################################################
# EDGE STACK ENVIRONMENT VARIABLES
# Copy this file to `.env` and adjust values for your environment
###############################################################################

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Deployment name / environment (informational)
ENVIRONMENT=edge

# System timezone (Node-RED + Postgres)
# IMPORTANT: keep UTC unless you REALLY know why you want local time
TIMEZONE=UTC


# ---------------------------------------------------------------------------
# PostgreSQL (Edge Database)
# ---------------------------------------------------------------------------

# Database name
POSTGRES_DB=edgy

# Database user
POSTGRES_USER=edgy

# Database password
POSTGRES_PASSWORD=edgy123

# Database port exposed on the host
POSTGRES_PORT=5432

# PostgreSQL container hostname (do NOT change unless you rename the service)
POSTGRES_HOST=edgy-postgres


# ---------------------------------------------------------------------------
# Node-RED
# ---------------------------------------------------------------------------

# Node-RED UI port
NODERED_PORT=1880

# Enable safe mode on startup (false in normal operation)
NODERED_SAFE_MODE=false


# ---------------------------------------------------------------------------
# Victron MQTT (Edge Ingestion)
# ---------------------------------------------------------------------------

# Victron GX / Venus OS MQTT broker
VICTRON_MQTT_HOST=192.168.1.19
VICTRON_MQTT_PORT=1883

# Optional authentication (usually empty for local GX)
VICTRON_MQTT_USERNAME=
VICTRON_MQTT_PASSWORD=

# Victron system serial (used in topic paths)
# Example topic: N/<serial>/battery/279/Soc
VICTRON_SYSTEM_SERIAL=c0619ab765bf


# ---------------------------------------------------------------------------
# Default Site / Asset Metadata (used by Node-RED)
# ---------------------------------------------------------------------------

# Logical site identifier (must match DB)
SITE_ID=TEST-SITE-EDGY

# Default protocol label stored in device_specs
DEFAULT_PROTOCOL=victron_mqtt

# Address stored in device_specs.address
DEFAULT_PROTOCOL_ADDRESS=tcp://192.168.1.19:1883
