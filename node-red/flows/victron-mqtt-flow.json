    {
        "id": "a7318aa1244c7448",
        "type": "function",
        "z": "50308b8fb0dc9c2e",
        "name": "upsert_device_from_point (topic+payload params)",
        "func": "const p = msg.payload;\nif (!p) return null;\n\nconst protocol = \"victron_mqtt\";\nconst address = \"tcp://192.168.1.19:1883\";\n\nconst vendor = \"Victron\";\nconst model = null;\nconst fw = null;\nconst profileHint = null;\n\nconst metaPatch = {\n  last_point: p.name,\n  last_unit: p.unit,\n  source: \"node-red\",\n  updated_at: new Date().toISOString()\n};\n\nconst sql = `\nINSERT INTO device_specs (\n  site_id, device_id,\n  protocol, address,\n  vendor, model, fw_version,\n  profile_hint,\n  last_seen, status,\n  meta\n)\nVALUES (\n  $1, $2,\n  $3, $4,\n  $5, $6, $7,\n  $8,\n  NOW(), 'online',\n  $9::jsonb\n)\nON CONFLICT (site_id, device_id)\nDO UPDATE SET\n  last_seen = NOW(),\n  status = 'online',\n  protocol = COALESCE(NULLIF(device_specs.protocol,''), EXCLUDED.protocol),\n  address  = COALESCE(NULLIF(device_specs.address,''),  EXCLUDED.address),\n  vendor   = COALESCE(device_specs.vendor,   EXCLUDED.vendor),\n  model    = COALESCE(device_specs.model,    EXCLUDED.model),\n  fw_version = COALESCE(device_specs.fw_version, EXCLUDED.fw_version),\n  profile_hint = COALESCE(device_specs.profile_hint, EXCLUDED.profile_hint),\n  meta = devices.meta || EXCLUDED.meta\nRETURNING site_id, device_id, last_seen, status;\n`;\n\nconst params = [\n  p.site_id,\n  p.device_id,\n  protocol,\n  address,\n  vendor,\n  model,\n  fw,\n  profileHint,\n  JSON.stringify(metaPatch)\n];\n\nmsg.topic = sql;\nmsg.payload = params;\n\nmsg.topic = msg.query;\nmsg.payload = msg.params;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
