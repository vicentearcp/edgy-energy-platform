    {
        "id": "5a6af6ea9b6ef3a8",
        "type": "function",
        "z": "50308b8fb0dc9c2e",
        "name": "victron2canonical (COMPLETE)",
        "func": "const SITE_ID = \"TEST-SITE-EDGY\";\nconst topic = msg.topic;\n\n// payload already parsed by JSON node: {value: ...}\nconst obj = msg.payload;\nconst v = (obj && typeof obj === \"object\" && \"value\" in obj) ? obj.value : obj;\nlet value = Number(v);\nif (Number.isNaN(value)) return null;\n\n// Decide device_id based on topic\nlet device_id = null;\nif (topic.includes(\"/battery/279/\")) device_id = \"victron_battery_279\";\nelse if (topic.includes(\"/vebus/276/\")) device_id = \"victron_vebus_276\";\nelse if (topic.includes(\"/solarcharger/278/\")) device_id = \"victron_solar_278\";\nelse return null;\n\n// Topic -> canonical name + raw unit\nlet name = null;\nlet unit = null;\n\nif (topic === \"N/c0619ab765bf/battery/279/Soc\") {\n  name = \"battery_soc_pct\";\n  unit = \"%\";\n} else if (topic === \"N/c0619ab765bf/vebus/276/Ac/Out/P\") {\n  name = \"site_load_kw\";\n  unit = \"W\";   // Victron power topics typically W\n} else if (topic === \"N/c0619ab765bf/solarcharger/278/Pv/Power\") {\n  name = \"pv_ac_power_kw\";\n  unit = \"W\";   // typically W\n} else {\n  return null;\n}\n\n// Normalize units to kW where applicable\nif (unit === \"W\" && name.endsWith(\"_kw\")) {\n  value = value / 1000.0;\n  unit = \"kW\";\n}\n\n// Bucket timestamp to 15-min so ON CONFLICT is stable\nconst now = new Date();\nconst bucketMs = 15 * 60 * 1000;\nconst ts = new Date(Math.floor(now.getTime() / bucketMs) * bucketMs).toISOString();\n\nmsg.payload = {\n  site_id: SITE_ID,\n  device_id,\n  time: ts,\n  name,\n  value,\n  unit,\n  quality: \"good\"\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
