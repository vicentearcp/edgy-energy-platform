    {
        "id": "d50f6b5f5afae0b8",
        "type": "function",
        "z": "50308b8fb0dc9c2e",
        "name": "build_sql_telemetry (topic+payload params)",
        "func": "const p = msg.payload;\nif (!p || p.value === null || p.value === undefined) return null;\n\nconst sql = `\nINSERT INTO measurement_live (ts, site_id, device_id, point_name, value, unit, quality)\nVALUES ($1,$2,$3,$4,$5,$6,$7)\nON CONFLICT (ts, site_id, device_id, point_name)\nDO UPDATE SET value=EXCLUDED.value, unit=EXCLUDED.unit, quality=EXCLUDED.quality\nRETURNING ts, site_id, device_id, point_name, value;\n`;\n\nconst params = [p.time, p.site_id, p.device_id, p.name, p.value, p.unit, p.quality];\n\n// Style A (many postgres nodes expect this)\nmsg.query  = sql;\nmsg.params = params;\n\n// Style B (some postgres nodes expect this)\nmsg.topic   = sql;\nmsg.payload = params;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
